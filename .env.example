# ── Frontend (client/) ───────────────────────────────────────────
# Leave blank for local dev — Vite proxy handles /api → localhost:8000
# Set to your deployed FastAPI URL for production (NO trailing slash):
# Example: https://your-backend.onrender.com
VITE_API_URL=

# ── Backend (server/) ────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# IMPORTANT: Update this with your Vercel frontend URL after deployment
# Format: comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-app.vercel.app

# ── Database (optional, for Docker Compose) ──────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/seafood_db
MLFLOW_TRACKING_URI=http://localhost:5000
